# Optional — leave blank to run fully offline (localStorage only).
VITE_FIREBASE_API_KEY=
# your-project.firebaseapp.com for local development. In production, set it to the app's own
# domain (e.g. your-app.vercel.app) so Google sign-in by redirect works in every browser
# (vercel.json proxies /__/auth to Firebase). See README → Google sign-in.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
