rules_version = '2';

// Werewolf Gamemaster — every document under users/{uid} is private to its owner.
// usernames/{username} maps a username to its account's sign-in email (the recovery email,
// or the Google address for an account made with Google).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Read by id only (sign-in and Forgot Password look it up before anyone is signed in);
    // never listed. Only the account it points to can create or change it.
    match /usernames/{username} {
      function validEntry() {
        return request.resource.data.keys().hasOnly(['uid', 'email', 'pendingEmail'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string;
      }
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && validEntry();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validEntry();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // An account made with Google has no username (''). It may claim one once, in the same
      // batch that creates its usernames/{username} entry.
      function claimsUsername() {
        let name = request.resource.data.get('username', '');
        return resource.data.get('username', '') == ''
          && name is string
          && name.matches('^[a-z0-9._-]{3,20}$')
          && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid;
      }

      allow read, delete: if isOwner(uid);
      // Profile: at most 10 saved role pools; a username can't be changed once it is set.
      allow create: if isOwner(uid)
        && request.resource.data.get('pools', []).size() <= 10;
      allow update: if isOwner(uid)
        && request.resource.data.get('pools', []).size() <= 10
        && (request.resource.data.get('username', '') == resource.data.get('username', '') || claimsUsername());

      // Finished games and the in-progress game.
      match /games/{gameId} {
        allow read, write: if isOwner(uid);
      }
      match /session/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
